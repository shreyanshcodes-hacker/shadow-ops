{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.scanner"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "variables": {
    "ENVIRONMENT": "production",
    "DEBUG": "false",
    "WORKER_SCAN_TIMEOUT": "1800",
    "WORKER_MAX_TARGET_SIZE_MB": "1000",
    "WORKER_MAX_FILE_SIZE_MB": "10",
    "WORKER_SEMGREP_TIMEOUT": "1800"
  }
}