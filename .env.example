# ShadowOps - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit real secrets to version control

# ===========================================
# Environment
# ===========================================
ENVIRONMENT=development
DEBUG=true

# ===========================================
# API Configuration
# ===========================================
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# ===========================================
# Database - Supabase PostgreSQL
# ===========================================
# Get from Supabase Dashboard > Settings > Database
# Use the "Session Pooler" connection string (port 6543) for production
# Use the direct connection (port 5432) for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shadowops
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ===========================================
# Firebase Authentication
# ===========================================
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ===========================================
# AI Providers (Stage 4)
# ===========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROK_API_KEY=
GROK_MODEL=grok-1
AI_MAX_FINDINGS_PER_RUN=10
AI_MAX_INPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# ===========================================
# Redis (for Celery, caching, rate limiting)
# ===========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===========================================
# n8n (Optional for Stage 1)
# ===========================================
N8N_WEBHOOK_URL=
N8N_API_KEY=

# ===========================================
# Security
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ===========================================
# Scan Configuration (Stage 3)
# ===========================================
# Scanner working directory (must exist and be writable by scanner user)
# For local development: create /scan-workspace and /scan-workspace/demo-target
# For production: use isolated worker with mounted volumes
SCAN_WORKSPACE_ROOT=/scan-workspace

# Semgrep configuration
SEMGREP_BINARY=semgrep
SEMGREP_VERSION=1.45.0

# Scan timeouts (seconds)
SCAN_TIMEOUT_SECONDS=1800
SCAN_PREP_TIMEOUT_SECONDS=300
SCAN_PARSE_TIMEOUT_SECONDS=120

# Target size limits
MAX_SCAN_TARGET_SIZE_MB=1000
MAX_FILE_SIZE_MB=10

# Scan concurrency
MAX_CONCURRENT_SCANS_PER_WORKSPACE=3

# Scan defaults
SCAN_BUDGET_DEFAULT_USD=10.0
SCAN_DEFAULT_PROFILE=CODE_SECURITY

# Semgrep rulesets (comma-separated)
SEMGREP_RULESETS=p/security-audit,p/secrets,p/owasp-top-ten

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO